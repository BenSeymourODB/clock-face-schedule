{
  "name": "clock-face-schedule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Analog clock dial rendering Google Calendar events as concentric time arcs, implemented natively in Google Apps Script",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "check-types": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check-plans": "node scripts/check-plans.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "push": "npm run build && clasp push --force",
    "open": "clasp open-script"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.12",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
